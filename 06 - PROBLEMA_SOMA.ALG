Algoritmo "problema_soma"

Var

   x, y, soma : inteiro

Inicio
   // 1. ENTRADA DE DADOS
   escreva("Digite o valor de X: ")
   leia(x)
   escreval
   escreva("Digite o valor de Y: ")
   leia(y)

   // 2. PROCESSAMENTO
   soma <- x + y

   // 3. SAÍDA DE DADOS
   escreval

   escreval("SOMA = ", soma)

Fimalgoritmo